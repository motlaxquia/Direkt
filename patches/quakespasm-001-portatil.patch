-ifeq ($(HOST_OS),haiku)
+# En macOS el OpenGL no es una libreria sino un framework del sistema, y no hay
+# libGL que enlazar: el enlazado falla con "ld: library 'GL' not found". En
+# MacOSX el Makefile aparte resuelve el problema, pero el generic no lo hacia.
+ifeq ($(HOST_OS),darwin)
+# Ademas del OpenGL, la aceleracion del raton de in_sdl.c usa IOKit, y en
+# Apple Silicon eso tampoco viene enlazado solo: el enlazado falla con
+# Undefined symbols for architecture arm64: "_IOMasterPort". Mismo problema que
+# tenia Ironwail, que va resuelto en patches/ironwail-001.
+COMMON_LIBS= -framework OpenGL -framework Cocoa -framework IOKit -framework CoreFoundation -lm
+else ifeq ($(HOST_OS),haiku)
 COMMON_LIBS= -lGL
 else
 COMMON_LIBS= -lGL -lm
