@@ -65,7 +65,13 @@
 
 // On OS X we call SDL_main from the launcher, but SDL2 doesn't redefine main
 // as SDL_main on OS X anymore, so we do it ourselves.
-#if defined(USE_SDL2) && defined(__APPLE__)
+// El "launcher" del que habla el comentario de arriba es el ejecutable del
+// paquete .app, que es el que define main y llama a SDL_main. Al compilar un
+// ejecutable a secas, como hace este proyecto, no hay nadie que defina main y el
+// enlazado acaba con Undefined symbols for architecture arm64: "_main".
+// Renombrar solo si hay launcher, que se avisa con
+// QUAKESPASM_APPLE_BUNDLE_LAUNCHER. El Makefile no lo define.
+#if defined(USE_SDL2) && defined(__APPLE__) && defined(QUAKESPASM_APPLE_BUNDLE_LAUNCHER)
 #define main SDL_main
 #endif
 
