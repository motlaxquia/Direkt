+/*
+================================================================================
+Direkt: recorrido de directorios (Sys_FindFirst / Sys_FindNext / Sys_FindClose)
+================================================================================
+Igual que en la version de Unix: se filtra por extension y el que llama ordena.
+================================================================================
+*/
+
+typedef struct winfindfile_s {
+	findfile_t		base;
+	HANDLE			handle;
+	WIN32_FIND_DATAA	data;
+	char			pattern[MAX_OSPATH];
+	char			filter[8];
+	int				borrado;		// FindFirstFile ya no devuelve nada
+} winfindfile_t;
+
+static int Sys_ExtEncaja (const char *nombre, const char *ext)
+{
+	return !ext[0] || ext[0] == '*'
+		|| !strcmp (ext, COM_FileGetExtension (nombre));
+}
+
+// Busca el siguiente fichero que encaje, dejando el directorio como estaba
+// para la siguiente llamada. Devuelve 0 si se acabaron.
+static int Sys_FindSiguiente (winfindfile_t *find)
+{
+	for (;;)
+	{
+		if (!FindNextFileA (find->handle, &find->data))
+		{
+			find->borrado = 1;
+			return 0;
+		}
+		// "." y ".." no son ficheros.
+		if (find->data.d_name[0] == '.' &&
+			(find->data.d_name[1] == 0 ||
+			 (find->data.d_name[1] == '.' && find->data.d_name[2] == 0)))
+			continue;
+		if (Sys_ExtEncaja (find->data.cFileName, find->filter))
+			return 1;
+	}
+}
+
+static void Sys_FillFindData (winfindfile_t *find)
+{
+	strlcpy (find->base.name, find->data.cFileName, sizeof (find->base.name));
+	find->base.attribs = 0;
+	if (find->data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+		find->base.attribs |= FA_DIRECTORY;
+}
+
+findfile_t *Sys_FindFirst (const char *dir, const char *ext)
+{
+	winfindfile_t	*ret;
+
+	if (!ext)
+		ext = "*";
+	else if (*ext == '.')
+		++ext;
+
+	if (!*dir || strlen (ext) >= sizeof (ret->filter))
+	{
+		Sys_Error ("Sys_FindFirst: bad dir or extension too long '%s'", ext);
+	}
+
+	if (!(ret = (winfindfile_t *) calloc (1, sizeof (winfindfile_t))))
+		Sys_Error ("Sys_FindFirst: out of memory");
+
+	strlcpy (ret->filter, ext, sizeof (ret->filter));
+	if (ext[0] == '*')
+		snprintf (ret->pattern, sizeof (ret->pattern), "%s\\*", dir);
+	else if (strchr (ext, '.'))
+		snprintf (ret->pattern, sizeof (ret->pattern), "%s\\*%s", dir, ext);
+	else
+		snprintf (ret->pattern, sizeof (ret->pattern), "%s\\*.%s", dir, ext);
+
+	// FindFirstFile ya devuelve el primero, pero puede ser "." o ".." y no
+	// encajar con el filtro, asi que se pasa por Sys_FindSiguiente.
+	ret->handle = FindFirstFileA (ret->pattern, &ret->data);
+	if (ret->handle == INVALID_HANDLE_VALUE)
+	{
+		free (ret);
+		return NULL;
+	}
+	ret->borrado = 0;
+
+	if (!Sys_ExtEncaja (ret->data.cFileName, ret->filter)
+		|| !Sys_FindSiguiente (ret))
+	{
+		Sys_FindClose ((findfile_t *) ret);
+		return NULL;
+	}
+
+	Sys_FillFindData (ret);
+	return (findfile_t *) ret;
+}
+
+findfile_t *Sys_FindNext (findfile_t *find)
+{
+	winfindfile_t	*wfind = (winfindfile_t *) find;
+
+	if (wfind->borrado || !Sys_FindSiguiente (wfind))
+	{
+		Sys_FindClose (find);
+		return NULL;
+	}
+	Sys_FillFindData (wfind);
+	return find;
+}
+
+void Sys_FindClose (findfile_t *find)
+{
+	winfindfile_t	*wfind = (winfindfile_t *) find;
+
+	if (!wfind)
+		return;
+	if (!wfind->borrado && wfind->handle != INVALID_HANDLE_VALUE)
+		FindClose (wfind->handle);
+	free (wfind);
+}
