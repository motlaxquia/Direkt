+/*
+================================================================================
+CATALOGO DE MUSICA
+================================================================================
+Por que existe
+
+La musica se pedia por un numero: la clave "sounds" del worldspawn, un entero de
+2 a 255, y el motor montaba "music/track%02d.ogg". El numero no dice nada: no se
+sabe que pista es cual hasta que se abre el fichero, y no se puede elegir una
+pista que no siga el patron trackNN. Luego el orden era el del numero, que es un
+orden arbitrario.
+
+Aqui la musica se pide por NOMBRE:
+
+    {
+    "classname" "worldspawn"
+    "music" "bosque.ogg"
+    }
+
+Y el motor la busca en music/. Da igual donde este el fichero y da igual como se
+llame: track02, bosque o nivel1_marcha.
+
+Como se mantiene lo viejo
+
+Los mapas de siempre (los de LibreQuake y los nuestros) siguen poniendo "sounds"
+con un numero y eso sigue funcionando igual, byte a byte. No se cambia ni una
+linea de su camino.
+
+Para que las dos cosas convivan sin ambiguedad, el servidor manda DOS bytes (ya
+los mandaba) y el segundo es el que dice cual de las dos es:
+
+    looptrack 255   el byte de la pista es un indice del catalogo (por nombre)
+    otra cosa       el byte de la pista es un numero de track, como siempre
+
+Los indices empiezan en 1. El 0 se queda significando "ninguna", que es lo que ya
+significaba.
+
+De donde sale la lista
+
+Se recorre la lista de rutas de busqueda del motor, no un directorio suelto: el
+juego puede arrancar con -basedir datos y la musica estar en datos/music/, no en
+music/. Asi el mismo codigo vale vaya el juego donde vaya.
+
+Solo se ven los ficheros sueltos de los directorios. Si alguien mete musica
+dentro de un PAK, la clave "music" no lo encontrara y seguira mandando la
+pista por numero, que es lo de siempre. La musica de Direkt va suelta, asi que
+eso no pasa.
+
+Orden
+
+El orden en el que un sistema devuelve un directorio no esta garantizado. Si el
+indice dependiera de ahi, el numero que manda el servidor no significaria lo
+mismo en el cliente. Por eso la lista se ordena por nombre antes de numerar:
+siempre el mismo indice para el mismo fichero, en cualquier maquina.
+================================================================================
+*/
+
+#define BGM_CATALOGO_MAX 512
+
+// nombre = ruta relativa ("music/x.ogg"), tal cual se le pasa al buscador del
+// motor, que la resuelve por las rutas de busqueda igual que cualquier otra.
+static struct {
+	char	nombre[MAX_QPATH];
+} bgm_catalogo[BGM_CATALOGO_MAX];
+
+static int bgm_catalogo_n = -1;		// -1 = sin hacer todavia
+
+// Las extensiones que se buscan, en el orden de preferencia del motor. Primero
+// la del fichero, luego el resto: si hay un bosque.ogg y un bosque.mp3, gana el
+// .ogg, que es lo que haria el numero.
+static const char *const bgm_catalogo_exts[] = {
+	".ogg", ".opus", ".mp3", ".flac", ".wav", NULL
+};
+
+// Por Extension y luego por nombre entero, para que la lista sea siempre la
+// misma y el indice signifique lo mismo.
+static int BGM_CatalogoCompara (const void *a, const void *b)
+{
+	return strcmp (*(const char **)a, *(const char **)b);
+}
+
+// Solo el nombre del fichero, sin la carpeta, para comparar y para no contar dos
+// veces el mismo fichero si aparece en mas de una ruta de busqueda.
+static const char *BGM_CatalogoSoloNombre (const char *ruta)
+{
+	const char *p = strrchr (ruta, '/');
+	return p ? p + 1 : ruta;
+}
+
+/*
+================================================================================
+BGM_CatalogoConstruir
+================================================================================
+*/
+void BGM_CatalogoConstruir (void)
+{
+	static char *nombres[BGM_CATALOGO_MAX];
+	searchpath_t	*s;
+	int total = 0, guardados = 0, i, k, por_tirar;
+
+	for (s = com_searchpaths; s && total < BGM_CATALOGO_MAX; s = s->next)
+	{
+		// Los PAK no se pueden recorrer como un directorio; se saltan.
+		if (s->pack || !s->filename[0])
+			continue;
+
+		for (i = 0; bgm_catalogo_exts[i] && total < BGM_CATALOGO_MAX; i++)
+		{
+			findfile_t *find;
+			// +16 para "/music" y el final. Sin esto el compilador avisa de que
+			// un directorio larguisimo podria cortar la ruta.
+			char ruta[MAX_OSPATH + 16];
+
+			snprintf (ruta, sizeof (ruta), "%s/%s", s->filename, MUSIC_DIRNAME);
+			if (!(find = Sys_FindFirst (ruta, bgm_catalogo_exts[i] + 1)))
+				continue;
+
+			// El ultimo Sys_FindNext cierra el directorio por su cuenta, asi que
+			// solo hay que cerrarlo aqui si se sale antes de tiempo. Cerrarlo dos
+			// veces revienta el motor.
+			por_tirar = 0;
+			do
+			{
+				if (find->attribs & FA_DIRECTORY)
+					continue;
+				if (total >= BGM_CATALOGO_MAX)
+				{
+					por_tirar = 1;
+					break;
+				}
+				nombres[total++] = Z_Malloc (MAX_QPATH);
+				snprintf (nombres[total-1], MAX_QPATH, "%s/%.48s",
+						MUSIC_DIRNAME, find->name);
+			}
+			while (Sys_FindNext (find));
+
+			if (por_tirar)
+				Sys_FindClose (find);
+		}
+	}
+
+	qsort (nombres, total, sizeof(char *), BGM_CatalogoCompara);
+
+	for (i = 0; i < total; i++)
+	{
+		const char *este = BGM_CatalogoSoloNombre (nombres[i]);
+
+		// El mismo nombre puede estar en varias rutas. Se queda la primera, que
+		// es la de mas prioridad, la misma que usaria el motor al abrirlo.
+		for (k = 0; k < guardados; k++)
+			if (!strcmp (BGM_CatalogoSoloNombre (bgm_catalogo[k].nombre), este))
+				break;
+		if (k < guardados)
+		{
+			Z_Free (nombres[i]);
+			continue;
+		}
+
+		q_strlcpy (bgm_catalogo[guardados].nombre, nombres[i], MAX_QPATH);
+		guardados++;
+		Z_Free (nombres[i]);
+	}
+
+	bgm_catalogo_n = guardados;
+}
+
+/*
+================================================================================
+BGM_CatalogoIndice
+================================================================================
+Devuelve el indice (empezando por 1) del fichero pedido, o 0 si no esta.
+Acepta el nombre con o sin la carpeta delante, y con o sin la extension.
+================================================================================
+*/
+int BGM_CatalogoIndice (const char *pedido)
+{
+	char limpio[MAX_QPATH];
+	const char *p;
+	size_t largo;
+	int i;
+
+	if (!pedido || !pedido[0])
+		return 0;
+	if (bgm_catalogo_n < 0)
+		BGM_CatalogoConstruir();
+	if (bgm_catalogo_n <= 0)
+		return 0;
+
+	// Quitar la carpeta: "music/bosque.ogg" y "bosque.ogg" son la misma.
+	p = strrchr (pedido, '/');
+	q_strlcpy (limpio, p ? p + 1 : pedido, sizeof(limpio));
+
+	for (i = 0; i < bgm_catalogo_n; i++)
+		if (!q_strcasecmp (BGM_CatalogoSoloNombre (bgm_catalogo[i].nombre), limpio))
+			return i + 1;
+
+	// Sin extension: se busca la primera que encaje con ese nombre. Asi un mapa
+	// puede poner "bosque" y sonar la pista que haya, sea .ogg o .mp3.
+	p = strrchr (limpio, '.');
+	if (!p)
+	{
+		largo = strlen (limpio);
+		for (i = 0; i < bgm_catalogo_n; i++)
+		{
+			const char *ext = strrchr (bgm_catalogo[i].nombre, '.');
+			if (!ext || (size_t)(ext - bgm_catalogo[i].nombre) != largo)
+				continue;
+			if (!q_strncasecmp (BGM_CatalogoSoloNombre (bgm_catalogo[i].nombre),
+						limpio, largo))
+				return i + 1;
+		}
+	}
+
+	return 0;
+}
+
+/*
+================================================================================
+BGM_CatalogoFichero
+================================================================================
+Devuelve la ruta relativa ("music/x.ogg") del indice, o NULL.
+================================================================================
+*/
+const char *BGM_CatalogoFichero (int indice)
+{
+	static char completo[MAX_QPATH];
+
+	if (indice < 1 || bgm_catalogo_n < 0 || indice > bgm_catalogo_n)
+		return NULL;
+	strlcpy (completo, bgm_catalogo[indice - 1].nombre, sizeof (completo));
+	return completo;
+}
+
+/*
+================================================================================
+BGM_PlayCDtrackIndex
+================================================================================
+Reproduce la pista del catalogo que dice el indice. Lo usa el camino nuevo, el
+del worldspawn con clave "music".
+================================================================================
+*/
+void BGM_PlayCDtrackIndex (int indice, qboolean looping)
+{
+	const char *fichero = BGM_CatalogoFichero (indice);
+
+	if (!fichero)
+	{
+		Con_Printf ("La musica del mapa (indice %d) no esta en %s/\n",
+				indice, MUSIC_DIRNAME);
+		return;
+	}
+
+	// Igual que BGM_PlayCDtrack: si ya suena esta misma, solo se reanuda en vez
+	// de parar y empezar otra vez.
+	if (bgmstream && !strcmp (bgmstream->name, fichero))
+	{
+		BGM_Resume ();
+		return;
+	}
+
+	BGM_Stop();
+
+	// S_CodecOpenStreamAny deja que sea el detector de extensiones el que mire el
+	// final del fichero, que es lo que se quiere: el mapa dice "bosque.ogg" y
+	// suena esa, sin importar el resto.
+	bgmstream = S_CodecOpenStreamAny (fichero, looping);
+	if (!bgmstream)
+		Con_Printf ("No se pudo abrir la musica %s\n", fichero);
+	else
+		Con_Printf ("Musica del mapa: %s\n", fichero);
+}
+
+/*
+================================================================================
+BGM_CatalogoListar
+================================================================================
+El comando "bgm_catalogo" escribe la lista de pistas con su indice. Es lo que hay
+que mirar para saber que nombre poner en la clave "music" de un mapa.
+================================================================================
+*/
+void BGM_CatalogoListar (void)
+{
+	int	i;
+
+	if (bgm_catalogo_n < 0)
+		BGM_CatalogoConstruir();
+
+	if (bgm_catalogo_n <= 0)
+	{
+		Con_Printf ("No hay musica en %s/\n", MUSIC_DIRNAME);
+		return;
+	}
+
+	Con_Printf ("%d pistas en %s/:\n", bgm_catalogo_n, MUSIC_DIRNAME);
+	for (i = 0; i < bgm_catalogo_n; i++)
+		Con_Printf ("  %3d  %s\n", i + 1, bgm_catalogo[i].nombre);
+}
+
