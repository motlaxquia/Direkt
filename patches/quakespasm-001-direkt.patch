+/*
+================================================================================
+Direkt: recorrido de directorios (Sys_FindFirst / Sys_FindNext / Sys_FindClose)
+================================================================================
+Se usa para listar music/ y saber que pistas hay y en que orden. El orden en el
+que el sistema devuelve un directorio no esta garantizado, asi que quien llama
+tiene que ordenar lo que recibe. Aqui solo se filtra por extension.
+================================================================================
+*/
+
+typedef struct unixfindfile_s {
+	findfile_t		base;
+	DIR				*handle;
+	struct dirent	*data;
+	char			filter[8];
+} unixfindfile_t;
+
+static struct dirent *Sys_ReadDirFiltered (DIR *handle, const char *ext)
+{
+	struct dirent	*data;
+
+	while ((data = readdir (handle)) != NULL)
+		if (!ext[0] || ext[0] == '*'
+			|| !strcmp (ext, COM_FileGetExtension (data->d_name)))
+			return data;
+	return NULL;
+}
+
+static void Sys_FillFindData (unixfindfile_t *find)
+{
+	strlcpy (find->base.name, find->data->d_name, sizeof (find->base.name));
+	find->base.attribs = 0;
+#ifdef DT_DIR
+	if (find->data->d_type == DT_DIR)
+		find->base.attribs |= FA_DIRECTORY;
+#endif
+}
+
+findfile_t *Sys_FindFirst (const char *dir, const char *ext)
+{
+	unixfindfile_t	*ret;
+	DIR				*handle;
+	struct dirent	*data;
+
+	if (!ext)
+		ext = "*";
+	else if (*ext == '.')
+		++ext;
+
+	if (strlen (ext) >= sizeof (ret->filter))
+		Sys_Error ("Sys_FindFirst: extension too long '%s'", ext);
+
+	if (!(handle = opendir (dir)))
+		return NULL;
+
+	if (!(data = Sys_ReadDirFiltered (handle, ext)))
+	{
+		closedir (handle);
+		return NULL;
+	}
+
+	if (!(ret = (unixfindfile_t *) calloc (1, sizeof (unixfindfile_t))))
+		Sys_Error ("Sys_FindFirst: out of memory");
+	ret->handle = handle;
+	ret->data = data;
+	strlcpy (ret->filter, ext, sizeof (ret->filter));
+	Sys_FillFindData (ret);
+
+	return (findfile_t *) ret;
+}
+
+findfile_t *Sys_FindNext (findfile_t *find)
+{
+	unixfindfile_t	*ufind = (unixfindfile_t *) find;
+
+	if (!(ufind->data = Sys_ReadDirFiltered (ufind->handle, ufind->filter)))
+	{
+		Sys_FindClose (find);
+		return NULL;
+	}
+	Sys_FillFindData (ufind);
+	return find;
+}
+
+void Sys_FindClose (findfile_t *find)
+{
+	unixfindfile_t	*ufind = (unixfindfile_t *) find;
+
+	if (!ufind)
+		return;
+	closedir (ufind->handle);
+	free (ufind);
+}
