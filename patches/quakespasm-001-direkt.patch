@@ Este parche lo genera scripts/gen-patches.sh. NO se edita a mano. @@
#
# Los cambios de Direkt al motor quakespasm, todos juntos. Para que se vea lo que
# hay dentro sin abrir el fichero:
#
#   Quake/Makefile
#   Quake/cvar.c
#   Quake/cvar.h
#   Quake/gl_screen.c
#   Quake/main_sdl.c
#   Quake/net_udp.c
#   Quake/sbar.c
#   Quake/view.c
#   Quake/wsaerror.h
#
# Son tres cosas, mas un cuarto punto:
#
#   1. La barra de estado se apaga con "+set scr_drawsb 0", y con ella se
#      apaga el hueco que dejaba (sb_lines), para que la vista 3D ocupe la
#      pantalla entera en vez de dejar una franja.
#   2. El aviso de una linea de scr_msgline, que el juego pinta en el motor.
#   3. Al morir, la camara se queda recta (cl_deadnoroll). El alabeo se
#      desactiva con la vida a cero, y el juego es el que avisa, porque desde
#      el cliente no se puede saber si el jugador esta muerto.
#   4. Portabilidad (macOS, MSYS2, ficheros sueltos) que ya estaba antes.
#
# Y las trampas del formato de parche, que han costado un rato:
#
#   * La cabecera lleva prefijos a/ y b/. Sin ellos, "patch -p1" se come el
#     directorio y no encuentra el fichero.
#   * El parche se genera contra el ORIGINAL, no contra el arbol ya parcheado.
#     Si no, el diff incluye los cambios del parche anterior dos veces.
--- a/Quake/Makefile	origen
+++ b/Quake/Makefile	2026-10-03 17:16:40.000000000 +0000
@@ -140,9 +140,16 @@
 endif
 ifeq ($(USE_CODEC_VORBIS),1)
 CFLAGS+= -DUSE_CODEC_VORBIS $(cpp_vorbisdec)
+# Homebrew deja las cabeceras de libvorbis fuera del path de inclusion por
+# defecto, porque son keg-only: estan en <prefix>/opt/libvorbis/include. Sin
+# esto el enlazado no encuentra <vorbis/vorbisfile.h> y da error, que es lo que
+# pasaba al compilar en macOS. pkg-config si que lo encuentra, y es lo que ya
+# se usa unas lineas mas abajo para opusfile.
+CFLAGS+= $(shell $(PKG_CONFIG) --cflags vorbisfile)
 CODECLIBS+= $(lib_vorbisdec)
 endif
 ifeq ($(USE_CODEC_MP3),1)
+CFLAGS+= $(shell $(PKG_CONFIG) --cflags mpg123)
 CFLAGS+= -DUSE_CODEC_MP3
 CODECLIBS+= $(lib_mp3dec)
 endif
@@ -162,7 +169,15 @@
 CFLAGS+= -DUSE_CODEC_UMX
 endif
 
-ifeq ($(HOST_OS),haiku)
+# En macOS el OpenGL no es una libreria sino un framework del sistema, y no hay
+# libGL que enlazar: el enlazado falla con "ld: library 'GL' not found".
+# Ademas, la aceleracion del raton de in_sdl.c usa IOKit, y en Apple Silicon eso
+# tampoco viene enlazado solo: falla con Undefined symbols for architecture
+# arm64: "_IOMasterPort". En MacOSX el Makefile aparte resuelve las dos cosas,
+# pero el generico no lo hacia.
+ifeq ($(HOST_OS),darwin)
+COMMON_LIBS= -framework OpenGL -framework Cocoa -framework IOKit -framework CoreFoundation -lm
+else ifeq ($(HOST_OS),haiku)
 COMMON_LIBS= -lGL
 else
 COMMON_LIBS= -lGL -lm
