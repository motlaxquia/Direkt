+// Aviso de una linea (o dos, separadas por \n) que se pinta abajo en pantalla.
+// Lo escribe el juego con "stuffcmd set scr_msgline ..." cuando el jugador
+// muere, y se borra cuando reaparece.
+cvar_t		scr_msgline = {"scr_msgline", "", CVAR_ARCHIVE};
