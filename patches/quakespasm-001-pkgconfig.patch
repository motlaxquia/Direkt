--- a/Quake/Makefile	2026-10-01 22:45:27.520268984 +0000
+++ b/Quake/Makefile	2026-10-01 22:45:27.522268984 +0000
@@ -140,9 +140,16 @@
 endif
 ifeq ($(USE_CODEC_VORBIS),1)
 CFLAGS+= -DUSE_CODEC_VORBIS $(cpp_vorbisdec)
+# Homebrew deja las cabeceras de libvorbis fuera del path de inclusion por
+# defecto, porque son keg-only: estan en <prefix>/opt/libvorbis/include. Sin
+# esto el enlazado no encuentra <vorbis/vorbisfile.h> y da error, que es lo que
+# pasaba al compilar en macOS. pkg-config si que lo encuentra, y es lo que ya
+# se usa unas lineas mas abajo para opusfile.
+CFLAGS+= $(shell $(PKG_CONFIG) --cflags vorbisfile)
 CODECLIBS+= $(lib_vorbisdec)
 endif
 ifeq ($(USE_CODEC_MP3),1)
+CFLAGS+= $(shell $(PKG_CONFIG) --cflags mpg123)
 CFLAGS+= -DUSE_CODEC_MP3
 CODECLIBS+= $(lib_mp3dec)
 endif
