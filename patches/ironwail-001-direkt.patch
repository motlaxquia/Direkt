+cvar_t		scr_msgline = {"scr_msgline", "", CVAR_ARCHIVE};
+
+// Al morir, la camara se queda recta. Lo pone el juego con un stuffcmd de una
+// palabra, porque desde el cliente no se puede saber si el jugador esta muerto
+// (la vida vive en el QC del servidor). Ver V_CalcViewRoll.
+cvar_t		cl_deadnoroll = {"cl_deadnoroll", "0", 0};
+
