@@ Este parche lo genera scripts/gen-patches.sh. NO se edita a mano. @@
#
# Los cambios de Direkt al motor ironwail, todos juntos. Para que se vea lo que
# hay dentro sin abrir el fichero:
#
#   CMakeLists.txt
#   Quake/cvar.c
#   Quake/cvar.h
#   Quake/gl_screen.c
#   Quake/main_sdl.c
#   Quake/sbar.c
#   Quake/view.c
#
# Son tres cosas, mas un cuarto punto:
#
#   1. La barra de estado se apaga con "+set scr_drawsb 0", y con ella se
#      apaga el hueco que dejaba (sb_lines), para que la vista 3D ocupe la
#      pantalla entera en vez de dejar una franja.
#   2. El aviso de una linea de scr_msgline, que el juego pinta en el motor.
#   3. Al morir, la camara se queda recta (cl_deadnoroll). El alabeo se
#      desactiva con la vida a cero, y el juego es el que avisa, porque desde
#      el cliente no se puede saber si el jugador esta muerto.
#   4. Portabilidad (macOS, MSYS2, ficheros sueltos) que ya estaba antes.
#
# Y las trampas del formato de parche, que han costado un rato:
#
#   * La cabecera lleva prefijos a/ y b/. Sin ellos, "patch -p1" se come el
#     directorio y no encuentra el fichero.
#   * El parche se genera contra el ORIGINAL, no contra el arbol ya parcheado.
#     Si no, el diff incluye los cambios del parche anterior dos veces.
--- a/CMakeLists.txt	origen
+++ b/CMakeLists.txt	2026-10-03 17:16:39.000000000 +0000
@@ -61,7 +61,39 @@
 endif()
 
 add_executable(ironwail ${IWAIL_SRC})
-if (UNIX)
+if (APPLE)
+	# En macOS, y no antes, hay que enlazar los frameworks a mano. La rama de
+	# UNIX de abajo solo mete "m", y con eso el ejecutable se enlazaba en Intel
+	# porque el dylib de SDL2 arrastraba IOKit de rebote. En Apple Silicon (arm64)
+	# ya no lo hace, y el enlazado falla con
+	#   Undefined symbols for architecture arm64: "_IOMasterPort" ...
+	# o sea, funciones de IOKit que existen de sobra pero contra las que no se
+	# ha enlazado nada. Se piden explicitamente.
+	#
+	# IOKit     : la aceleracion del raton (in_sdl.c)
+	# Cocoa     : NSAutoreleasePool y demas en in_sdl.c
+	# CoreFoundation : CFSTR() y los tipos de IOKit
+	# OpenGL    : el motor dibuja con el OpenGL del sistema, que va como
+	#             framework, no como -lGL
+	target_link_libraries(ironwail PRIVATE
+		"-framework IOKit"
+		"-framework Cocoa"
+		"-framework CoreFoundation"
+		"-framework OpenGL"
+	)
+	target_link_options(ironwail PRIVATE
+		"-Wl,-rpath,@loader_path"
+		"-Wl,-rpath,/usr/local/lib"
+	)
+	# SDL_main.h en macOS renombra el main del programa a SDL_main, pensando que
+	# es SDL quien pone el main de verdad. Cuando el SDL2 es un dylib, como el
+	# de Homebrew, no hay nadie que lo ponga y el enlazado acaba con
+	#   Undefined symbols for architecture arm64: "_main"
+	# SDL_MAIN_HANDLED dice que el programa trae su propio main, que es lo que
+	# ya hacia falta en Windows (WinMain) pero aqui no estaba puesto.
+	target_compile_definitions(ironwail PRIVATE SDL_MAIN_HANDLED)
+	set(ENABLE_USERDIRS TRUE CACHE STRING "Enable user directories")
+elseif (UNIX)
 	target_link_libraries(ironwail PRIVATE m)
 	set(ENABLE_USERDIRS TRUE CACHE STRING "Enable user directories")
 elseif (WIN32)
