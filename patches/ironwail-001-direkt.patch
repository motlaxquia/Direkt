 	Cmd_AddCommand ("resetcfg", Cvar_ResetCfg_f);
+
+	Cvar_RegisterVariable (&scr_drawsb);
+	Cvar_RegisterVariable (&scr_msgline);
+	Cvar_RegisterVariable (&cl_deadnoroll);
 }
 
