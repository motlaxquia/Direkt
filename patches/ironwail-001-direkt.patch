--- a/Quake/sbar.c	origen
+++ b/Quake/sbar.c	2026-10-03 15:39:32.000000000 +0000
@@ -1605,6 +1605,56 @@
 Sbar_Draw
 ===============
 */
+extern cvar_t	scr_drawsb;
+
+// El aviso de abajo (scr_msgline): "moriste / pulsa Enter para reintentar".
+//
+// Hace falta en el motor porque QuakeC no tiene forma de escribir en pantalla.
+// Se pinta encima de la barra, que con scr_drawsb a 0 no dibuja nada, y con la
+// barra puesta se pinta justo encima de ella.
+//
+// Se registra en Cvar_Init y no en Sbar_Init por lo mismo que scr_drawsb: los
+// "+set" de la linea de comandos y los "exec" de la configuracion corren antes
+// de Host_Init.
+extern cvar_t	scr_msgline;
+
+void Sbar_DrawMsgline (void)
+{
+	int y;
+	const char *line;
+	int i;
+
+	if (!scr_msgline.string[0])
+		return;
+	// Con la consola abierta a pantalla completa taparia el aviso, asi que no se
+	// dibuja.
+	if (scr_con_current == vid.height)
+		return;
+
+	// El canvas se pone a NULL a proposito. Esta funcion se llama justo antes de
+	// que Sbar_Draw elija su propio canvas, y Draw_String dibuja en el que haya
+	// puesto: sin ponerlo, sale con la textura que hubiera de antes y no se ve
+	// nada.
+	GL_SetCanvas (CANVAS_DEFAULT);
+
+	y = glheight - 8;
+
+	// Con "\n" se parte en varias lineas, y se dibujan hacia arriba desde la
+	// ultima para que la de "moriste" quede arriba del todo.
+	line = scr_msgline.string;
+	for (i = 1; i < 32; i++)
+	{
+		if (!line[i])
+			break;
+		if (line[i] == '\n')
+			y -= 8;
+	}
+	if (i >= 32)
+		return;
+
+	Draw_String (8, y, scr_msgline.string);
+}
+
 void Sbar_Draw (void)
 {
 	qboolean invuln;
@@ -1612,6 +1662,14 @@
 	float x, y, w, h; //johnfitz
 	qpic_t *pic;
 
+	// Ver el comentario de scr_drawsb en cvar.c. El extern va aqui porque
+	// sbar.c solo incluye quakedef.h y no llega a cvar.h.
+	if (!scr_drawsb.value)
+	{
+		Sbar_DrawMsgline ();
+		return;
+	}
+
 	if (scr_con_current == vid.height)
 		return;		// console is full screen
 
