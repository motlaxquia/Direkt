 /*
+================================================================================
+DIREKT: teclas que el juego necesita ver
+================================================================================
+El juego no recibe las teclas, solo recibe lo que el jugador hace con ellas:
+mover, disparar, usar, saltar y un impulso. Las demas teclas no llegan.
+
+Eso basta para casi todo, pero el parkour necesita saber si se mantiene una
+tecla modificadora: Shift para el dash y el planeo, Ctrl para deslizarse. Y no
+hay forma de saberlo desde ahi, porque "+speed" solo multiplica el movimiento en
+este lado de la linea y no manda ningun bit al servidor.
+
+La salida es el impulso, que es lo unico que el cliente manda de forma fiable y
+que el juego ya usa para todo lo demas (agacharse, reintentar, las pruebas).
+Enquanto se mantenga la tecla, el impulso se repite cada frame, que es como se
+usa desde el juego: como nivel, no como flanco.
+
+El reparto se cambia con el cvar cl_teclas_juego, con pares "tecla=numero" y sin
+importar mayusculas:
+
+    set cl_teclas_juego "SHIFT=27 CTRL=28"
+
+Un numero por clave y uno solo por frame: si se pulsan dos a la vez, gana la
+primera de la lista. Es lo justo para las teclas modificadoras del parkour, que
+se usan de una en una.
+================================================================================
+*/
+int Key_ImpulsoTeclas (const char *especificacion)
+{
+	const char	*p;
+	char		tecla[32];
+	int			longitud;
+	if (!especificacion || !especificacion[0])
+		return 0;
+
+	p = especificacion;
+	while (*p)
+	{
+		int		numero;
+		int		keynum;
+
+		// El nombre de la tecla va hasta el '='.
+		longitud = 0;
+		while (*p && *p != '=' && *p != ' ' && *p != '\t')
+		{
+			if (longitud < (int)sizeof (tecla) - 1)
+				tecla[longitud++] = *p;
+			p++;
+		}
+		tecla[longitud] = 0;
+
+		if (!*p || *p == ' ' || *p == '\t')
+		{
+			// Un nombre suelto no dice nada: el numero va detras del '='.
+			while (*p == ' ' || *p == '\t')
+				p++;
+			continue;
+		}
+
+		p++;		// salta el '='
+		numero = 0;
+		while (*p >= '0' && *p <= '9')
+			numero = numero * 10 + (*p++ - '0');
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		keynum = Key_StringToKeynum (tecla);
+		if (keynum < 0 || keynum >= MAX_KEYS)
+			continue;
+		if (!keydown[keynum])
+			continue;
+		if (numero < 0 || numero > 255)
+			continue;
+
+		return numero;
+	}
+
+	return 0;
+}
