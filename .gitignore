# Todo lo descargado / generado vive en build/
build/
*.log

# Binarios sueltos
fteqcc
fteqcc.log
*.o
*.a

# Salvados de Quake / estado de ejecucion
cfg/
screenshots/
*.dem
*.sav

# El pak y los bsp de LibreQuake son BSD-3 pero se descargan, no se versionan
*.pak
build/lq/

# Python
__pycache__/
*.pyc

# Logica de juego compilada: se genera con 'make game'
# progs.dat SI se versiona a proposito: es bytecode independiente de la
# plataforma, y sin el el motor no tiene logica de juego. Versionarlo deja al
# generador y al editor funcionando sin fteqcc, que en macOS y en Windows no
# esta en ningun gestor de paquetes. Cuando fteqcc esta disponible, make game lo
# vuelve a compilar igual.
direkt/progs.lno
game/progs.lno
game/progs.dat
game/*.o

# Configuracion y estado que escribe el motor al arrancar
direkt/direkt-test.cfg

# written by the engines in the repo root
history.txt
