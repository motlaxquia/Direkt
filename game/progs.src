qc/defs.qc
qc/assets.qc
qc/subs.qc
qc/entities.qc
qc/structure.qc
qc/items.qc
qc/weapons.qc
qc/player.qc
qc/parkour.qc
qc/client.qc
qc/direkt.qc

#endlist
